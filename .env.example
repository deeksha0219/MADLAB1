# GrabNGo - Environment Configuration Template
# NOTE: React Native does not automatically load .env into JS runtime without extra native tooling.
# The authoritative typed runtime configuration is managed in src/config/environment.ts.
# This template documents parameters for developers, CI/CD, and future build tools.
# NEVER COMMIT .env

# Active Environment: local | staging
APP_ENV=local

# Firebase Project Configuration:
# - For Local Emulator Mode: demo-grabngo-local
# - For Staging Cloud Mode: mad-lab-a9665
FIREBASE_PROJECT_ID=demo-grabngo-local

# Local Firebase Emulator Host and Ports (Used when APP_ENV=local)
# On Android emulator, use 10.0.2.2. On iOS simulator or physical device, use host IP.
EMULATOR_HOST=10.0.2.2
EMULATOR_AUTH_PORT=9099
EMULATOR_FIRESTORE_PORT=8080
EMULATOR_FUNCTIONS_PORT=5001

# Debug Logging (true | false)
ENABLE_ENV_DEBUG_LOGS=true
